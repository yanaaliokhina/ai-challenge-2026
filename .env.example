# .env.example — copy to .env in your working day's src/ folder and fill in values
PYTHONPATH=.

# Anthropic (required for most days)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI (optional, used on some days)
OPENAI_API_KEY=your-openai-api-key-here

# Redis (optional, used on Day 25)
REDIS_URL=redis://localhost:6379

# App settings
LOG_LEVEL=INFO
DEFAULT_MODEL=claude-haiku-4-5-20251001
